# Copy to .env and fill in your own values: cp .env.example .env
#
# This file is read by BOTH halves of the project — the server (omniroute-mcp)
# and the client agent (omniroute-agent). Real environment variables
# take precedence over .env: the host agent's config (mcpServers.env) always
# overrides the file.
#
# If .env is not next to the project, point to it explicitly:
#   OMNIROUTE_ENV_FILE=/path/to/.env

# Address of the local OmniRoute instance (no trailing slash).
OMNIROUTE_BASE_URL=http://localhost:20128

# OmniRoute API key. Needs the "manage" scope, otherwise management endpoints return 401.
# Where to get it: Dashboard -> API Keys -> Create, enable "Management Access".
OMNIROUTE_API_KEY=sk-xxxxxxxxxxxxxxxx

# HTTP request timeout, in seconds. Routing with fallbacks can be slow.
OMNIROUTE_TIMEOUT=120

# Default model: the agent's "brain" and the default for the omniroute_chat tool.
# Required — there is no default in the code. To list available names, use
# omniroute-discover or the omniroute_list_models tool.
#
# Tip: specify a concrete model rather than an auto/* alias. The gateway
# resolves aliases to a provider on the fly and sometimes returns 400 Invalid model.
CLIENT_MODEL=kr/claude-sonnet-4.5

# Address of the network version of the MCP server — only needed for omniroute-agent-http.
# OMNIROUTE_MCP_URL=http://127.0.0.1:8765/mcp
